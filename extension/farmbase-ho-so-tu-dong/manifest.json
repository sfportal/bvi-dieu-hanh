{
  "manifest_version": 3,
  "name": "FarmBase - Tổng hợp hồ sơ vùng trồng",
  "version": "2.2.0",
  "description": "Kiểm tra hồ sơ vùng trồng, nông hộ, lô trên admin.farmbase.vn theo trạng thái và tổ chức; báo cáo, xuất CSV; owner đồng bộ một chiều sang BVI Điều hành.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://admin.farmbase.vn/*",
    "https://api.farmbase.vn/*",
    "https://pkckduidwfcncipwzdxa.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://admin.farmbase.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
